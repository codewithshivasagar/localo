generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SHOP_OWNER
  SHOP_STAFF
  CUSTOMER
  SUPPORT_AGENT
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
  SUSPENDED
  DELETED
}

enum ShopStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SUSPENDED
  REJECTED
  CLOSED
}

enum ShopVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ShopCommissionStatus {
  NOT_CONFIGURED
  ACTIVE
  OVERDUE
  PAUSED
}

enum ShopTeamRole {
  OWNER
  MANAGER
  STAFF
  VIEWER
}

enum ShopTeamStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ProductType {
  PRODUCT
  SERVICE
  DIGITAL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  HIDDEN
  ARCHIVED
  REJECTED
}

enum ProductVariantStatus {
  ACTIVE
  HIDDEN
  OUT_OF_STOCK
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum ReviewReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
  REFUNDED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
  ENQUIRY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CommissionType {
  PERCENTAGE
  FIXED
  HYBRID
}

enum BillingCycle {
  MONTHLY
  WEEKLY
  YEARLY
  MANUAL
}

enum CommissionSettingStatus {
  ACTIVE
  PAUSED
  OVERDUE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum ShopPaymentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  fullName        String     @default("") @db.VarChar(160)
  email           String     @unique @db.VarChar(255)
  phone           String?    @unique @db.VarChar(30)
  passwordHash    String?
  avatarMediaId   String?    @db.Uuid
  role            UserRole   @default(CUSTOMER)
  userType        UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  firstName       String?    @db.VarChar(80)
  lastName        String?    @db.VarChar(80)
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  phoneVerifiedAt DateTime?  @db.Timestamptz(6)
  lastLoginAt     DateTime?  @db.Timestamptz(6)
  metadata        Json       @default("{}")
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?  @db.Timestamptz(6)

  avatarMedia            MediaAsset?          @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  refreshTokens          RefreshToken[]
  roleAssignments        UserRoleAssignment[] @relation("UserRoleAssignments")
  assignedRoles          UserRoleAssignment[] @relation("AssignedUserRoles")
  mediaAssets            MediaAsset[]
  addresses              UserAddress[]
  ownedShops             Shop[]               @relation("OwnedShops")
  adminCreatedShops      Shop[]               @relation("AdminCreatedShops")
  approvedShops          Shop[]               @relation("ApprovedShops")
  shopTeamMemberships    ShopTeamMember[]     @relation("ShopTeamUser")
  shopTeamInvites        ShopTeamMember[]     @relation("ShopTeamInviter")
  reviewedShopDocuments  ShopDocument[]
  shopStatusChanges      ShopStatusHistory[]
  favorites              UserFavorite[]
  recentlyViewedItems    RecentlyViewedItem[]
  searchQueries          SearchQuery[]
  reviews                Review[]
  reviewReplies          ReviewReply[]
  reviewReports          ReviewReport[]
  carts                  Cart[]
  orders                 Order[]
  orderStatusChanges     OrderStatusHistory[]
  shopPaymentsReceived   ShopPayment[]
  supportTicketsCreated  SupportTicket[]      @relation("SupportTicketCreator")
  supportTicketsAssigned SupportTicket[]      @relation("SupportTicketAssignee")
  supportMessages        SupportMessage[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  appSettingsUpdated     AppSetting[]
  importJobs             ImportJob[]

  @@index([role])
  @@index([userType])
  @@index([status])
  @@index([deletedAt])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String
  deviceName String?   @db.VarChar(120)
  ipAddress  String?   @db.Inet
  userAgent  String?
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(120)
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  userRoles       UserRoleAssignment[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(120)
  module      String   @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRoleAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  shopId       String?  @db.Uuid
  assignedById String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user       User  @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  shop       Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("AssignedUserRoles", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, shopId])
  @@index([userId])
  @@index([shopId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MediaAsset {
  id              String   @id @default(uuid()) @db.Uuid
  ownerUserId     String?  @db.Uuid
  storageProvider String   @db.VarChar(40)
  bucket          String?  @db.VarChar(120)
  path            String
  publicUrl       String?
  mimeType        String   @db.VarChar(120)
  sizeBytes       BigInt?
  width           Int?
  height          Int?
  altText         String?  @db.VarChar(255)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  ownerUser          User?               @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  userAvatars        User[]              @relation("UserAvatar")
  shopLogos          Shop[]              @relation("ShopLogo")
  shopCovers         Shop[]              @relation("ShopCover")
  shopDocuments      ShopDocument[]
  categoryIcons      Category[]          @relation("CategoryIcon")
  categoryImages     Category[]          @relation("CategoryImage")
  productBrandLogos  ProductBrand[]
  productMedia       ProductMedia[]
  shopPaymentProofs  ShopPayment[]
  supportAttachments SupportAttachment[]
  importJobs         ImportJob[]

  @@index([ownerUserId])
  @@index([mimeType])
  @@map("media_assets")
}

model Country {
  id           String  @id @default(uuid()) @db.Uuid
  iso2         String  @unique @db.Char(2)
  name         String  @db.VarChar(120)
  currencyCode String  @db.Char(3)
  phoneCode    String? @db.VarChar(8)
  isActive     Boolean @default(true)

  states        State[]
  userAddresses UserAddress[]
  shopLocations ShopLocation[]

  @@map("countries")
}

model State {
  id        String  @id @default(uuid()) @db.Uuid
  countryId String  @db.Uuid
  name      String  @db.VarChar(120)
  code      String? @db.VarChar(20)
  isActive  Boolean @default(true)

  country       Country        @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities        City[]
  userAddresses UserAddress[]
  shopLocations ShopLocation[]

  @@unique([countryId, name])
  @@index([countryId])
  @@map("states")
}

model City {
  id       String  @id @default(uuid()) @db.Uuid
  stateId  String  @db.Uuid
  name     String  @db.VarChar(120)
  slug     String  @db.VarChar(140)
  isActive Boolean @default(true)

  state         State          @relation(fields: [stateId], references: [id], onDelete: Restrict)
  areas         Area[]
  userAddresses UserAddress[]
  shopLocations ShopLocation[]

  @@unique([stateId, slug])
  @@index([stateId])
  @@map("cities")
}

model Area {
  id        String   @id @default(uuid()) @db.Uuid
  cityId    String   @db.Uuid
  name      String   @db.VarChar(140)
  slug      String   @db.VarChar(160)
  pincode   String?  @db.VarChar(20)
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  isActive  Boolean  @default(true)

  city          City           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  userAddresses UserAddress[]
  shopLocations ShopLocation[]

  @@unique([cityId, slug])
  @@index([cityId])
  @@index([pincode])
  @@map("areas")
}

model UserAddress {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  label     String?   @db.VarChar(80)
  line1     String    @db.VarChar(255)
  line2     String?   @db.VarChar(255)
  areaId    String?   @db.Uuid
  cityId    String?   @db.Uuid
  stateId   String?   @db.Uuid
  countryId String?   @db.Uuid
  pincode   String?   @db.VarChar(20)
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area    Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  city    City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  state   State?   @relation(fields: [stateId], references: [id], onDelete: SetNull)
  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([areaId])
  @@index([latitude, longitude])
  @@map("user_addresses")
}

model Shop {
  id                 String                 @id @default(uuid()) @db.Uuid
  ownerUserId        String                 @db.Uuid
  name               String                 @db.VarChar(180)
  slug               String                 @unique @db.VarChar(220)
  legalName          String?                @db.VarChar(220)
  description        String?
  primaryCategoryId  String?                @db.Uuid
  status             ShopStatus             @default(DRAFT)
  verificationStatus ShopVerificationStatus @default(UNVERIFIED)
  commissionStatus   ShopCommissionStatus   @default(NOT_CONFIGURED)
  logoMediaId        String?                @db.Uuid
  coverMediaId       String?                @db.Uuid
  phone              String?                @db.VarChar(30)
  email              String?                @db.VarChar(255)
  websiteUrl         String?
  ratingAvg          Decimal                @default(0) @db.Decimal(3, 2)
  ratingCount        Int                    @default(0)
  isFeatured         Boolean                @default(false)
  createdByAdminId   String?                @db.Uuid
  approvedById       String?                @db.Uuid
  approvedAt         DateTime?              @db.Timestamptz(6)
  metadata           Json                   @default("{}")
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?              @db.Timestamptz(6)

  ownerUser            User                    @relation("OwnedShops", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdByAdmin       User?                   @relation("AdminCreatedShops", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  approvedBy           User?                   @relation("ApprovedShops", fields: [approvedById], references: [id], onDelete: SetNull)
  primaryCategory      Category?               @relation("PrimaryShopCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  logoMedia            MediaAsset?             @relation("ShopLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  coverMedia           MediaAsset?             @relation("ShopCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  roleAssignments      UserRoleAssignment[]
  locations            ShopLocation[]
  businessHours        ShopBusinessHour[]
  specialHours         ShopSpecialHour[]
  teamMembers          ShopTeamMember[]
  documents            ShopDocument[]
  statusHistory        ShopStatusHistory[]
  categories           ShopCategory[]
  products             Product[]
  favorites            UserFavorite[]
  recentlyViewedItems  RecentlyViewedItem[]
  clickedSearchQueries SearchQuery[]
  reviews              Review[]
  cartItems            CartItem[]
  orders               Order[]
  commissionSetting    ShopCommissionSetting?
  commissionInvoices   ShopCommissionInvoice[]
  payments             ShopPayment[]
  supportTickets       SupportTicket[]

  @@index([ownerUserId])
  @@index([status])
  @@index([primaryCategoryId])
  @@index([isFeatured])
  @@index([ratingAvg])
  @@map("shops")
}

model ShopLocation {
  id                   String   @id @default(uuid()) @db.Uuid
  shopId               String   @db.Uuid
  label                String   @default("Main") @db.VarChar(100)
  addressLine1         String   @db.VarChar(255)
  addressLine2         String?  @db.VarChar(255)
  areaId               String?  @db.Uuid
  cityId               String?  @db.Uuid
  stateId              String?  @db.Uuid
  countryId            String?  @db.Uuid
  pincode              String?  @db.VarChar(20)
  latitude             Decimal  @db.Decimal(10, 7)
  longitude            Decimal  @db.Decimal(10, 7)
  googlePlaceId        String?  @db.VarChar(255)
  isPrimary            Boolean  @default(true)
  isServiceAreaEnabled Boolean  @default(false)
  serviceRadiusKm      Decimal? @db.Decimal(6, 2)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  shop               Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  area               Area?              @relation(fields: [areaId], references: [id], onDelete: SetNull)
  city               City?              @relation(fields: [cityId], references: [id], onDelete: SetNull)
  state              State?             @relation(fields: [stateId], references: [id], onDelete: SetNull)
  country            Country?           @relation(fields: [countryId], references: [id], onDelete: SetNull)
  productInventories ProductInventory[]

  @@index([shopId])
  @@index([areaId])
  @@index([latitude, longitude])
  @@map("shop_locations")
}

model ShopBusinessHour {
  id        String    @id @default(uuid()) @db.Uuid
  shopId    String    @db.Uuid
  dayOfWeek Int       @db.SmallInt
  opensAt   DateTime? @db.Time(6)
  closesAt  DateTime? @db.Time(6)
  isClosed  Boolean   @default(false)
  breaks    Json      @default("[]")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dayOfWeek])
  @@index([shopId])
  @@map("shop_business_hours")
}

model ShopSpecialHour {
  id        String    @id @default(uuid()) @db.Uuid
  shopId    String    @db.Uuid
  date      DateTime  @db.Date
  opensAt   DateTime? @db.Time(6)
  closesAt  DateTime? @db.Time(6)
  isClosed  Boolean   @default(false)
  reason    String?   @db.VarChar(160)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, date])
  @@map("shop_special_hours")
}

model ShopTeamMember {
  id          String         @id @default(uuid()) @db.Uuid
  shopId      String         @db.Uuid
  userId      String         @db.Uuid
  role        ShopTeamRole
  status      ShopTeamStatus @default(ACTIVE)
  invitedById String?        @db.Uuid
  joinedAt    DateTime?      @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  deletedAt   DateTime?      @db.Timestamptz(6)

  shop      Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User  @relation("ShopTeamUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("ShopTeamInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([shopId, userId])
  @@index([userId])
  @@index([role])
  @@map("shop_team_members")
}

model ShopDocument {
  id              String         @id @default(uuid()) @db.Uuid
  shopId          String         @db.Uuid
  documentType    String         @db.VarChar(60)
  documentNumber  String?        @db.VarChar(120)
  mediaId         String         @db.Uuid
  status          DocumentStatus @default(PENDING)
  reviewedById    String?        @db.Uuid
  reviewedAt      DateTime?      @db.Timestamptz(6)
  rejectionReason String?
  expiresAt       DateTime?      @db.Date
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)

  shop       Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  media      MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([documentType])
  @@index([status])
  @@map("shop_documents")
}

model ShopStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  shopId      String      @db.Uuid
  fromStatus  ShopStatus?
  toStatus    ShopStatus
  reason      String?
  changedById String?     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)

  shop      Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([createdAt])
  @@map("shop_status_history")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  parentId     String?  @db.Uuid
  name         String   @db.VarChar(160)
  slug         String   @db.VarChar(180)
  description  String?
  iconMediaId  String?  @db.Uuid
  imageMediaId String?  @db.Uuid
  level        Int      @default(0) @db.SmallInt
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  parent               Category?                    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children             Category[]                   @relation("CategoryTree")
  iconMedia            MediaAsset?                  @relation("CategoryIcon", fields: [iconMediaId], references: [id], onDelete: SetNull)
  imageMedia           MediaAsset?                  @relation("CategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  primaryShops         Shop[]                       @relation("PrimaryShopCategory")
  shopCategories       ShopCategory[]
  productCategoryLinks ProductCategoryLink[]
  attributeDefinitions ProductAttributeDefinition[]

  @@unique([parentId, slug])
  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model ShopCategory {
  id         String   @id @default(uuid()) @db.Uuid
  shopId     String   @db.Uuid
  categoryId String   @db.Uuid
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([shopId, categoryId])
  @@index([categoryId])
  @@map("shop_categories")
}

model ProductBrand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(160)
  slug        String   @unique @db.VarChar(180)
  logoMediaId String?  @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  logoMedia MediaAsset? @relation(fields: [logoMediaId], references: [id], onDelete: SetNull)
  products  Product[]

  @@index([name])
  @@map("product_brands")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  shopId           String        @db.Uuid
  brandId          String?       @db.Uuid
  title            String        @db.VarChar(220)
  slug             String        @db.VarChar(260)
  description      String?
  shortDescription String?       @db.VarChar(500)
  productType      ProductType   @default(PRODUCT)
  status           ProductStatus @default(DRAFT)
  sku              String?       @db.VarChar(100)
  searchKeywords   String[]      @default([])
  tags             String[]      @default([])
  basePrice        Decimal?      @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  currencyCode     String        @default("INR") @db.Char(3)
  taxRate          Decimal       @default(0) @db.Decimal(5, 2)
  isFeatured       Boolean       @default(false)
  ratingAvg        Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount      Int           @default(0)
  publishedAt      DateTime?     @db.Timestamptz(6)
  metadata         Json          @default("{}")
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?     @db.Timestamptz(6)

  shop                 Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  brand                ProductBrand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryLinks        ProductCategoryLink[]
  variants             ProductVariant[]
  inventory            ProductInventory[]
  media                ProductMedia[]
  attributeValues      ProductAttributeValue[]
  favorites            UserFavorite[]
  recentlyViewedItems  RecentlyViewedItem[]
  clickedSearchQueries SearchQuery[]
  reviews              Review[]
  cartItems            CartItem[]
  orderItems           OrderItem[]

  @@unique([shopId, slug])
  @@index([shopId, status])
  @@index([brandId])
  @@index([isFeatured])
